{
  "name": "nagi-vault",
  "private": true,
  "workspaces": [
    "api",
    "web",
    "infra"
  ],
  "scripts": {
    "build": "npm run build -w web",
    "test": "npm test -w api && npm test -w web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "synth": "npm run synth -w infra",
    "deploy": "npm run deploy -w infra"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.15"
  }
}
